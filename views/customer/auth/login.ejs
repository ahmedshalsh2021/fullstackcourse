  <%- include('../../shared/includes/head.ejs' , {pageTitle: 'Login'}) %>
  <link rel="stylesheet" href="/styles/forms.css">
  <link rel="stylesheet" href="/styles/auth.css">
  <body>
    <%- include('../../shared/includes/header.ejs') %>
    <main>
        <h1>Login</h1>
         <% if(inputData.errorMessage){%>
          <section class="alert">
            <h2>Invalid Credentials</h2>
            <p><%= inputData.errorMessage %></p>
          </section>
        <%} %>
        <form action="/login" method="POST">
          <input type="hidden" name= "_csrf" value="<%= locals.csrfToken %>">
          <p>
            <label for="email">E-mail</label>
            <input type="email" name="email" value="<%= inputData.email %>" required>
          </p>
           <p>
            <label for="password">Password</label>
            <input type="password" name="password" value="<%= inputData.password %>" id="password" >
          </p>    
          <button class="btn">Login</button>
           <p id="switch-form"><a href="/signup">Don't have an account? Sign up instead</a></p>
        </form>
    </main>
    
<%- include('../../shared/includes/footer.ejs') %>